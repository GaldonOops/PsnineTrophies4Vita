{
  "name": "vitasdk",
  "image": "vitasdk/vitasdk:2026.08",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cmake-tools",
        "llvm-vs-code-extensions.vscode-clangd"
      ]
    }
  },
  "containerEnv": {
    "VITASDK": "/usr/local/vitasdk"
  },
  "mounts": [
    "source=psnine-vitasdk-bash,type=volume,target=/root/.bash_history"
  ]
}

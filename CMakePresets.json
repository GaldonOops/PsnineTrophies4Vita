{
  "version": 3,
  "configurePresets": [
    {
      "name": "vitasdk",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "$env{VITASDK}/share/vita.toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vitasdk",
      "configurePreset": "vitasdk"
    }
  ]
}
